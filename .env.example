# Telegram Bot Token
# Get from: https://t.me/BotFather
BOT_TOKEN=your_bot_token_here

# Supabase Configuration
# Get from: https://supabase.com/dashboard/project/[your-project]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT Secret (kept for reference, not used by client JWT generation)
# Get from: Supabase Dashboard > Settings > API > JWT Settings
SUPABASE_JWT_SECRET=your_jwt_secret_here
